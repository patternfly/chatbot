{
  "name": "@patternfly/chatbot-tree-shaking-demo",
  "private": true,
  "version": "0.0.0",
  "description": "Demonstrates tree-shaking with @patternfly/chatbot and PatternFly dependencies",
  "type": "module",
  "scripts": {
    "dev": "vite --mode full",
    "dev:minimal": "vite --mode minimal",
    "dev:barrel": "vite --mode barrel",
    "build": "node scripts/build-and-analyze.mjs",
    "build:minimal": "vite build --mode minimal",
    "build:barrel": "vite build --mode barrel",
    "analyze": "node scripts/build-and-analyze.mjs"
  },
  "dependencies": {
    "@patternfly/chatbot": "*",
    "@patternfly/react-core": "^6.6.0",
    "@patternfly/react-icons": "^6.6.0",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "rollup-plugin-visualizer": "^5.14.0",
    "typescript": "^5.3.3",
    "vite": "^6.2.0"
  }
}
